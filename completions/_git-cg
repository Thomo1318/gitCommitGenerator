#compdef git-cg
# @generated by usage-cli from usage.kdl
local curcontext="$curcontext"

_git_cg() {
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in git-cg." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_file="${TMPDIR:-/tmp}/usage__usage_spec_git_cg.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name git-cg
bin git-cg
about "GitOps AI Commit Generator and Release Automation"
flag "-i --interactive" help="Enable terminal-native interactive review via gum."
flag "-e --engine" help="AI engine to use when running git-cg directly." default=mtplx {
    arg <ENGINE>
}
flag "-d --dry-run" help="Generate and print the commit message without applying a commit."
flag "-v --verbose" help="Enable verbose output."
flag --strict help="Exit non-zero on failure for standalone CLI use."
flag --enable-semantic help="Enable Phase 1 semantic producers (default: GIT_CG_ENABLE_SEMANTIC env or off)."
flag --no-enable-semantic help="Disable Phase 1 semantic producers for this run."
flag --rank-arbitrate help="Allow Low-confidence pre-LLM intent arbitration when -i + TTY (default: GIT_CG_RANK_ARBITRATE env or auto)."
flag --no-rank-arbitrate help="Disable Low-confidence intent arbitration; keep top rank + telemetry."
flag --gold-strict help="Resolve gold lint to strict mode without enabling general --strict."
flag "-r --recover" help="Recover and retry the last generated commit message without querying the AI."
cmd commit help="Generate an AI commit message based on staged changes." {
    flag --rank-arbitrate help="Allow Low-confidence pre-LLM intent arbitration when -i + TTY (default: GIT_CG_RANK_ARBITRATE env or auto)."
    flag --no-rank-arbitrate help="Disable Low-confidence intent arbitration; keep top rank + telemetry."
    flag --enable-semantic help="Enable Phase 1 semantic producers (default: GIT_CG_ENABLE_SEMANTIC env or off)."
    flag --no-enable-semantic help="Disable Phase 1 semantic producers for this run."
    flag --gold-strict help="Resolve gold lint to strict mode without enabling general --strict."
    flag "-i --interactive" help="Enable terminal-native interactive review via gum when a TTY is available."
    flag --strict help="Exit non-zero on failure. Leave OFF for git hooks so a failed generation never blocks the commit."
    flag "-d --dry-run" help="Do not write the commit message, just print it."
    flag "-v --verbose" help="Enable verbose output."
    flag "-e --engine" help="AI engine to use (e.g. omlx, mtplx)." default=mtplx {
        arg <ENGINE>
    }
    arg "[COMMIT_MSG_FILE]" help="Path to the commit message file" required=#false default=".git/COMMIT_EDITMSG"
    arg "[COMMIT_SOURCE]" help="Source of the commit message (e.g., 'message', 'template', 'merge', 'squash', 'commit')" required=#false default=""
}
cmd sop help="Display the GitOps SOP matrices and workflows."
cmd release help="Calculate SemVer bump (SemVer 2.0.0 Rule 4 and 9 compliant), inject versions into changed files, and generate Changelog." {
    flag --pre-release help="Add or bump a pre-release identifier (e.g., 'alpha', 'rc')" {
        arg <IDENTIFIER>
    }
}
__USAGE_EOF__
  local -a completions=()
  while IFS= read -r line; do
    completions+=("$line")
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${words[@]}")
  _describe 'completions' completions -S ''
  return 0
}

if [ "$funcstack[1]" = "_git_cg" ]; then
    _git_cg "$@"
else
    compdef _git_cg git-cg
fi

