flowchart TD
    %% === PROJECT GOALS ===
    %% Ultimate Goal: A stable, portable, and secure GitOps commit generator ready for public release.
    %% Current Goal: Finalize tech debt cleanup, AI refactor, and prepare for a second agent review.

    %% === START ===
    %% @project_start [start, closed, 2026-06-06, user]
    project_start("Project Start<br/><sub>git-cg: High-performance CLI<br/>utility for generating AI-driven<br/>hybrid commit messages with<br/>strict Pydantic validation</sub>")

    %% @ultimate_goal [end, opened, 2026-06-06, user]
    ultimate_goal("Project Goal<br/><sub>A stable, portable, and<br/>secure GitOps commit generator<br/>ready for public release<br/>and daily usage</sub>")

    %% === COMPLETED WORK ===
    %% @core_engine [ai-task, closed, 2026-06-06, user]
    core_engine("Core Logic Engine<br/><sub>Implemented the main Python<br/>AI engine using Typer, Instructor,<br/>and Pydantic for deterministic<br/>structured data extraction</sub>")

    %% @hk_migration [ai-task, closed, 2026-06-06, user]
    hk_migration("Git Hooks Migration<br/><sub>Migrated from pre-commit to<br/>hk for deterministic hook<br/>orchestration, adding linting<br/>and commit-msg hooks</sub>")

    %% @version_sync_and_cleanup [ai-task, closed, 2026-06-06, ai]
    version_sync_and_cleanup("Version Sync & Env Cleanup<br/><sub>Updated PyProject and Node versions<br/>(3.14, 0.1.7), archived obsolete scripts,<br/>cleaned up MANIFEST and scratch files,<br/>and injected Pitchfork integration notes</sub>")

    %% @semver_refactor [ai-task, closed, 2026-06-06, ai]
    semver_refactor("Semantic Versioning Engine Refactor<br/><sub>Rewrote release.py using robust<br/>regex for identifying breaking changes<br/>(via !) and isolated commit bodies<br/>using safe delimiter injection</sub>")

    %% @ai_routing_compression [ai-task, closed, 2026-06-06, ai]
    ai_routing_compression("AI Engine Routing & Compression<br/><sub>Refactored main.py with an ENGINE_REGISTRY<br/>for easy model additions. Implemented<br/>unconditional rtk diff compression<br/>to reduce token consumption overhead</sub>")

    %% @gum_tui_integration [ai-task, closed, 2026-06-10, ai]
    gum_tui_integration("Gum TUI Integration<br/><sub>Replaced macOS alerter with<br/>Charmbracelet's Gum for a native,<br/>keyboard-centric terminal UI<br/>and eliminated DND deadlocks</sub>")

    %% @zensical_docs [ai-task, closed, 2026-06-10, ai]
    zensical_docs("Zensical Docs Pipeline<br/><sub>Configured Zensical for MkDocs<br/>generation, automated deployment<br/>via GitHub Actions, and hardened<br/>CI against zizmor warnings</sub>")

    %% @test_suite [ai-task, closed, 2026-06-13, ai]
    test_suite("Standardized Test Suite<br/><sub>Established comprehensive tests<br/>for intent, main, ranker,<br/>and sop modules to track<br/>and compare LLM outputs</sub>")

    %% @guided_regeneration [ai-task, closed, 2026-06-13, ai]
    guided_regeneration("Guided Regeneration<br/><sub>Implemented selective delta<br/>rendering and invariant contract<br/>enforcement. Added prompt reauthorisation<br/>and bounded directives</sub>")

    %% @tui_enhancements [ai-task, closed, 2026-06-13, ai]
    tui_enhancements("TUI Enhancements<br/><sub>Added structured multi-issue<br/>references to the interactive<br/>review flow for robust<br/>issue tracking</sub>")

    %% @release_v0_1_0 [ai-task, closed, 2026-06-13, ai]
    release_v0_1_0("v0.1.0 Release<br/><sub>Released v0.1.0 with plain text<br/>commit output, semver bumping,<br/>and changelog generation based on<br/>the gitmoji matrix</sub>")

    %% @opik_datasets_phase6 [ai-task, closed, 2026-06-18, ai]
    opik_datasets_phase6("Opik Datasets Phase 6<br/><sub>Migrated evaluation pipeline to<br/>use Opik Cloud datasets instead of<br/>local JSONL files. Implemented triage<br/>and compilation scripts.</sub>")

    %% @promptfoo_phase7_8 [ai-task, closed, 2026-06-18, ai]
    promptfoo_phase7_8("Promptfoo Security & Eval<br/><sub>Implemented promptfoo eval with JS assertions<br/>for message length and hybrid syntax regex.<br/>Configured red-teaming plugins and<br/>sync script to ingest traces into Opik.</sub>")

    %% === FUTURE WORK ===
    %% @second_agent_review [ai-task, opened, 2026-06-06, ai]
    second_agent_review("Second Agent Review<br/><sub>Trigger another comprehensive<br/>agentic review to check the codebase<br/>for architecture gaps, portability,<br/>and finalize public readiness</sub>")

    %% @config_system [ai-task, opened, 2026-06-06, ai]
    config_system("Configuration System<br/><sub>Create a robust configuration<br/>system to ensure portability<br/>and manage user preferences<br/>without hardcoded values</sub>")

    %% @docs_overhaul [ai-task, opened, 2026-06-13, ai]
    docs_overhaul("Documentation Overhaul<br/><sub>Overhaul Zensical docs to<br/>reflect recent architecture changes,<br/>remove obsolete pages, and<br/>align with git-cg formatting</sub>")

    %% @package_publishing [ai-task, opened, 2026-06-13, ai]
    package_publishing("Package Publishing<br/><sub>Configure GitHub Actions to<br/>automatically publish the hatchling<br/>package to PyPI and Homebrew<br/>upon release tagging</sub>")

    %% @sentry_phase9 [ai-task, opened, 2026-06-18, ai]
    sentry_phase9("Sentry Observability Phase 9<br/><sub>Centralize Sentry init, implement<br/>before_send PII scrubber, and target<br/>exception-swallowing boundaries.</sub>")

    %% === CONNECTIONS ===
    project_start --> core_engine
    core_engine --> hk_migration
    hk_migration --> version_sync_and_cleanup
    version_sync_and_cleanup --> semver_refactor
    semver_refactor --> ai_routing_compression
    ai_routing_compression --> gum_tui_integration
    gum_tui_integration --> zensical_docs
    zensical_docs --> test_suite
    test_suite --> guided_regeneration
    guided_regeneration --> tui_enhancements
    tui_enhancements --> release_v0_1_0
    
    release_v0_1_0 --> second_agent_review
    release_v0_1_0 --> config_system
    release_v0_1_0 --> docs_overhaul
    release_v0_1_0 --> package_publishing
    release_v0_1_0 --> opik_datasets_phase6
    opik_datasets_phase6 --> promptfoo_phase7_8
    promptfoo_phase7_8 --> sentry_phase9

    second_agent_review -.-> ultimate_goal
    config_system -.-> ultimate_goal
    docs_overhaul -.-> ultimate_goal
    package_publishing -.-> ultimate_goal
    sentry_phase9 -.-> ultimate_goal

