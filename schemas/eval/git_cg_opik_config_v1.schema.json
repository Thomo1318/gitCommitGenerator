{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "opik_environment": {
      "description": "Closed git_cg_opik_config_v1 environment vocabulary (plan §7.2.14)",
      "enum": [
        "development",
        "dogfood",
        "ci",
        "eval",
        "staging",
        "production"
      ],
      "type": "string"
    },
    "opik_mode": {
      "description": "Closed git_cg_opik_config_v1 mode vocabulary (plan §7.2.14 / §10.6)",
      "enum": [
        "off",
        "local_only",
        "mirror",
        "strict_mirror"
      ],
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "project_lanes": {
      "additionalProperties": false,
      "description": "Pinned Opik project lanes — no silent Default Project (INT-11 / FIND-022)",
      "properties": {
        "ci": {
          "$ref": "#/$defs/non_empty_string"
        },
        "eval": {
          "$ref": "#/$defs/non_empty_string"
        },
        "import": {
          "$ref": "#/$defs/non_empty_string"
        },
        "live": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "required": [
        "live",
        "eval",
        "ci",
        "import"
      ],
      "type": "object"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    }
  },
  "$id": "https://git-cg.local/schemas/eval/git_cg_opik_config_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "local_only",
              "mirror",
              "strict_mirror"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "projects"
        ]
      }
    }
  ],
  "description": "Mode/project/environment/flush config (plan §7.2.14). Must not require Default Project fallthrough. Secrets never stored here.",
  "properties": {
    "check_tls_certificate": {
      "type": "boolean"
    },
    "config_path": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/opik_environment"
    },
    "flush_timeout_ms": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "meta": {
      "type": "object"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "mode": {
      "$ref": "#/$defs/opik_mode"
    },
    "notes": {
      "type": "string"
    },
    "projects": {
      "$ref": "#/$defs/project_lanes"
    },
    "redaction_profile": {
      "allOf": [
        {
          "$ref": "#/$defs/redaction_profile"
        },
        {
          "not": {
            "const": "raw_dev_unsafe"
          }
        }
      ]
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "schema_version": {
      "const": "git_cg_opik_config_v1"
    },
    "track_disable": {
      "type": "boolean"
    },
    "workspace": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "mode",
    "environment",
    "redaction_profile",
    "flush_timeout_ms",
    "track_disable",
    "check_tls_certificate"
  ],
  "title": "git_cg_opik_config_v1",
  "type": "object"
}
