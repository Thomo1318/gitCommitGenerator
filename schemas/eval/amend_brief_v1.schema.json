{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/amend_brief_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "R11 amend-session brief (operator evidence pack; not an accept gate). l1 rollups are computed from ScoreCaseResult/ScoreSuiteResult projections. Attachments (lane_c / dogfood / doctor) remain advisory and last-N bounded.",
  "properties": {
    "schema_version": {
      "const": "amend_brief_v1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "brief_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "session_thread_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "commit_subject": {
      "type": "string"
    },
    "trailers": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Typed trailer map (redacted as needed); free-form values only."
    },
    "l1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "family_rollups",
        "failure_ids",
        "path_class",
        "gold_counters",
        "blocking"
      ],
      "properties": {
        "regime": {
          "$ref": "#/$defs/non_empty_string"
        },
        "family_rollups": {
          "type": "object",
          "description": "Per-family rollup projections (computed, not bundle fields).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean",
                "string",
                "null",
                "array",
                "object"
              ]
            }
          }
        },
        "failure_ids": {
          "$ref": "#/$defs/string_list"
        },
        "path_class": {
          "$ref": "#/$defs/non_empty_string"
        },
        "gold_counters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "null"
            ]
          }
        },
        "blocking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "codes": {
              "$ref": "#/$defs/string_list"
            },
            "reasons": {
              "$ref": "#/$defs/string_list"
            }
          },
          "required": [
            "blocked"
          ]
        }
      }
    },
    "l2_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "$ref": "#/$defs/string_list"
        },
        "sop_tension_notes": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "preference_pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chosen_version_id": {
          "type": "string"
        },
        "rejected_version_ids": {
          "$ref": "#/$defs/string_list"
        },
        "owner_approved": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "lane_c_attachments": {
      "type": "array",
      "description": "Last-N advisory Lane C′ / dogfood attachments (bounded).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "judge_id",
          "pin_ref",
          "mode",
          "authority"
        ],
        "properties": {
          "run_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "judge_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "pin_ref": {
            "$ref": "#/$defs/pin_ref"
          },
          "mode": {
            "enum": [
              "off",
              "sample",
              "always",
              "async"
            ],
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "polarity": {
            "$ref": "#/$defs/polarity"
          },
          "rationale_short": {
            "type": "string",
            "maxLength": 2000
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "created_at": {
            "$ref": "#/$defs/iso8601"
          },
          "authority": {
            "const": "advisory"
          },
          "metric_id": {
            "type": "string"
          },
          "message_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "green": {
          "type": "boolean"
        },
        "check_ids": {
          "$ref": "#/$defs/string_list"
        },
        "failure_ids": {
          "$ref": "#/$defs/string_list"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "opik_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string"
        },
        "trace_ids": {
          "$ref": "#/$defs/string_list"
        },
        "experiment_name": {
          "type": "string"
        },
        "dataset_name": {
          "type": "string"
        }
      }
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/iso8601"
    },
    "authority": {
      "description": "Brief is operator evidence only.",
      "const": "advisory"
    },
    "redaction_profile": {
      "$ref": "#/$defs/redaction_profile"
    }
  },
  "required": [
    "schema_version",
    "id",
    "brief_id",
    "l1"
  ],
  "title": "amend_brief_v1",
  "type": "object"
}
