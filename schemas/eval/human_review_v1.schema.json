{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/human_review_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Human review attachment (advisory HITL row). authority is advisory only; no human review state can sole-promote gold. Frozen rating shape is the typed scores object with dotted metric keys (human.craft_rating?, human.gold_dispute?, human.regime_label?) — supersedes the open top-level rating alternative. reviewer is an opaque local handle (not email/display name).",
  "properties": {
    "schema_version": {
      "const": "human_review_v1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "review_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "case_id": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "reviewer": {
      "description": "Opaque reviewer id (not email/display name).",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "reviewer_id": {
      "description": "Alias-friendly opaque reviewer id (same constraints as reviewer).",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/iso8601"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "description": "Typed dotted-key human.* scores (frozen shape).",
      "properties": {
        "human.craft_rating": {
          "type": "number"
        },
        "human.gold_dispute": {
          "type": "boolean"
        },
        "human.regime_label": {
          "enum": [
            "A",
            "B",
            "unknown"
          ],
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "authority": {
      "const": "advisory"
    },
    "redaction_profile": {
      "$ref": "#/$defs/redaction_profile"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    }
  },
  "required": [
    "schema_version",
    "id",
    "review_id",
    "authority",
    "redaction_profile",
    "scores"
  ],
  "title": "human_review_v1",
  "type": "object"
}
