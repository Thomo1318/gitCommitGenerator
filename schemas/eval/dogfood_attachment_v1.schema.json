{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/dogfood_attachment_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "R12 dogfood attachment (advisory). mode is closed off|sample|always|async. authority is always advisory; never sole gate or gold promoter. message_sha256 links without storing full text twice. rationale is bounded. When mode=sample, sample_seed/sample_rate/population_id plus selected_ids and/or selected_set_hash are required so membership is offline-reproducible (no wall-clock membership changes).",
  "properties": {
    "schema_version": {
      "const": "dogfood_attachment_v1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "run_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "judge_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "pin_ref": {
      "$ref": "#/$defs/pin_ref"
    },
    "mode": {
      "enum": [
        "off",
        "sample",
        "always",
        "async"
      ],
      "type": "string"
    },
    "metric_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "polarity": {
      "$ref": "#/$defs/polarity"
    },
    "rationale_short": {
      "type": "string",
      "maxLength": 2000,
      "description": "Bounded short rationale; no raw diffs/secrets."
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "$ref": "#/$defs/iso8601"
    },
    "authority": {
      "const": "advisory"
    },
    "message_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "session_thread_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "sample_seed": {
      "type": "string",
      "description": "Deterministic sample seed (explicit --seed or stable hash of population identity).",
      "minLength": 1
    },
    "sample_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Sample rate in [0,1] used for membership selection."
    },
    "population_id": {
      "type": "string",
      "description": "Stable population identity (e.g. suite_id or experiment_id|suite_id).",
      "minLength": 1
    },
    "selected_ids": {
      "$ref": "#/$defs/string_list",
      "description": "Selected member ids for this sample draw (optional when selected_set_hash is present)."
    },
    "selected_set_hash": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 over canonical sorted selected_ids; alone permits offline membership reproduction with seed/rate/population."
    },
    "capture_on": {
      "enum": [
        "pass",
        "fail",
        "all"
      ],
      "type": "string",
      "description": "Corpus capture eligibility for this attachment (owner-set; separate from product accept)."
    },
    "hard_negative_candidate": {
      "type": "boolean",
      "description": "True when capture_on includes fail and the row is retained as a hard-negative candidate (never a product fail)."
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "judge_id",
    "pin_ref",
    "mode",
    "authority",
    "message_sha256"
  ],
  "title": "dogfood_attachment_v1",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "sample"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "sample_seed",
          "sample_rate",
          "population_id"
        ],
        "anyOf": [
          {
            "required": [
              "selected_ids"
            ]
          },
          {
            "required": [
              "selected_set_hash"
            ]
          }
        ]
      }
    }
  ]
}
