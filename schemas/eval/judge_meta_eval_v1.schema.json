{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "meta_eval_error_type": {
      "enum": [
        "FP",
        "FN",
        "OK",
        "judge_error"
      ],
      "type": "string"
    },
    "meta_eval_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "expected_label",
        "error_type"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "judge_input_ref": {
          "description": "Scrubbed reference only — never raw secrets or full unredacted bodies as ambient default",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            }
          ]
        },
        "expected_label": {
          "$ref": "#/$defs/non_empty_string"
        },
        "judge_output_label": {
          "type": "string"
        },
        "judge_output_score": {
          "type": "number"
        },
        "equals": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "error_type": {
          "$ref": "#/$defs/meta_eval_error_type"
        }
      }
    },
    "meta_eval_aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fp_rate",
        "fn_rate",
        "n"
      ],
      "properties": {
        "fp_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fn_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "equals_count": {
          "type": "integer",
          "minimum": 0
        },
        "judge_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "fp_count": {
          "type": "integer",
          "minimum": 0
        },
        "fn_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/judge_meta_eval_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Judge meta-eval / lab row (non-authoritative). Offline Equals / FP / FN calibration envelope (R2). Labels never enter ordinary judge_input. Never product/golden/first-CI gate.",
  "properties": {
    "aggregates": {
      "$ref": "#/$defs/meta_eval_aggregates"
    },
    "authority": {
      "const": "lab"
    },
    "cohort_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meta_eval_item"
      }
    },
    "judge_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "meta": {
      "type": "object"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "network_policy": {
      "const": "offline_preferred"
    },
    "notes": {
      "type": "string"
    },
    "pin_ref": {
      "$ref": "#/$defs/pin_ref"
    },
    "polarity": {
      "$ref": "#/$defs/polarity"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "schema_version": {
      "const": "judge_meta_eval_v1"
    }
  },
  "required": [
    "schema_version",
    "id",
    "judge_id",
    "pin_ref",
    "polarity",
    "authority"
  ],
  "title": "judge_meta_eval_v1",
  "type": "object"
}
