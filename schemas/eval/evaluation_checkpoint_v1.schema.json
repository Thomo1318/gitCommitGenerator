{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/evaluation_checkpoint_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resume/checkpoint record (S6). Stores suite progress under an explicit compat_hash; resume must fail closed on EVAL_COMPAT_HASH_MISMATCH when the D9 preimage diverges. Canonical stored name is compat_hash only (no compatibility_hash alias). mode is a closed five-value resume set.",
  "properties": {
    "schema_version": {
      "const": "evaluation_checkpoint_v1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "experiment_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "compat_hash": {
      "$ref": "#/$defs/sha256"
    },
    "completed_case_ids": {
      "$ref": "#/$defs/string_list"
    },
    "pending_case_ids": {
      "$ref": "#/$defs/string_list"
    },
    "last_progress_at": {
      "$ref": "#/$defs/iso8601"
    },
    "mode": {
      "description": "Closed resume/recovery mode set (five modes).",
      "enum": [
        "fresh_suite_run",
        "resume_missing",
        "recompute_scores",
        "replay_generation",
        "export_only"
      ],
      "type": "string"
    },
    "cursor": {
      "type": "string"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "suite_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "checkpoint_id",
    "experiment_id",
    "compat_hash",
    "completed_case_ids",
    "pending_case_ids",
    "last_progress_at",
    "mode"
  ],
  "title": "evaluation_checkpoint_v1",
  "type": "object"
}
