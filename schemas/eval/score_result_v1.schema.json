{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@([a-f0-9]{64}|[A-Za-z0-9._-]+)$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    }
  },
  "$id": "https://git-cg.local/schemas/eval/score_result_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "polarity": {
            "const": "pass_fail"
          }
        },
        "required": [
          "polarity"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "polarity": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          }
        },
        "required": [
          "polarity"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      }
    }
  ],
  "description": "Canonical score envelope. Requires metric_id, polarity, authority, source. Train/advisory scores never imply gate.deterministic_pass by themselves (M11).",
  "properties": {
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "blame_span": {
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "type": "number"
    },
    "evidence": {
      "type": "object"
    },
    "evidence_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "failure_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "family": {
      "$ref": "#/$defs/family"
    },
    "feedback_target": {
      "$ref": "#/$defs/feedback_target"
    },
    "feedback_target_id": {
      "type": "string"
    },
    "input_artifact": {
      "$ref": "#/$defs/input_artifact"
    },
    "metric_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "name": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "pin_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "polarity": {
      "$ref": "#/$defs/polarity"
    },
    "product_authority": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/severity"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "threshold": {
      "type": "number"
    },
    "value": {
      "description": "bool only when polarity=pass_fail; number otherwise",
      "type": [
        "number",
        "boolean"
      ]
    }
  },
  "required": [
    "authority",
    "metric_id",
    "polarity",
    "source",
    "value"
  ],
  "title": "score_result_v1",
  "type": "object"
}
