{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    }
  },
  "$id": "https://git-cg.local/schemas/eval/export_batch_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Export batch envelope (plan \u00a77.2.10). Wire contract for a size-bounded, idempotent projection batch. Distinct from the queue ops row and the content-addressed payload artifact. Default ceiling \u22644MB unless owner raises. Failure NEVER flips gate.deterministic_pass.",
  "properties": {
    "batch_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "error_class": {
      "enum": [
        "export_network",
        "export_auth",
        "export_validation",
        "export_size"
      ],
      "type": "string"
    },
    "experiment_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "idempotency_key": {
      "$ref": "#/$defs/sha256"
    },
    "item_refs": {
      "description": "Stable refs for Layer-A items included in this batch",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "max_bytes": {
      "default": 4194304,
      "minimum": 1,
      "type": "integer"
    },
    "meta": {
      "type": "object"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "payload_ref": {
      "minLength": 1,
      "type": "string"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/non_empty_string",
      "description": "Pinned project/lane \u2014 no Default Project dump"
    },
    "redaction_profile": {
      "allOf": [
        {
          "$ref": "#/$defs/redaction_profile"
        },
        {
          "not": {
            "const": "raw_dev_unsafe"
          }
        }
      ]
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "schema_version": {
      "const": "export_batch_v1"
    },
    "size_bytes": {
      "description": "Canonical post-envelope wire size (bytes)",
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "description": "ExportStatus (envelope) \u2014 distinct from QueueStatus",
      "enum": [
        "pending",
        "ok",
        "failed",
        "skipped"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "batch_id",
    "project",
    "experiment_id",
    "item_refs",
    "idempotency_key",
    "size_bytes",
    "status",
    "redaction_profile"
  ],
  "title": "export_batch_v1",
  "type": "object"
}
