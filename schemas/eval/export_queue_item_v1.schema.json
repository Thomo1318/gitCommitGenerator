{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    }
  },
  "$id": "https://git-cg.local/schemas/eval/export_queue_item_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Local Layer-A export queue ops row under .eval/export_queue/. QueueStatus state machine is distinct from envelope ExportStatus (E7). Carries payload_ref + payload_sha256 + lease/retry metadata; never the transport body alone.",
  "properties": {
    "attempt_count": {
      "minimum": 0,
      "type": "integer"
    },
    "batch_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "claimed_by": {
      "type": "string"
    },
    "envelope_status": {
      "description": "Mirrored ExportStatus from the batch envelope (not QueueStatus)",
      "enum": [
        "pending",
        "ok",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "last_error_class": {
      "enum": [
        "export_network",
        "export_auth",
        "export_validation",
        "export_size"
      ],
      "type": "string"
    },
    "lease_expires_at": {
      "description": "UTC ISO-8601 lease expiry for sending rows",
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "next_retry_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "payload_ref": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "project": {
      "type": "string"
    },
    "queue_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "redaction_profile": {
      "allOf": [
        {
          "$ref": "#/$defs/redaction_profile"
        },
        {
          "not": {
            "const": "raw_dev_unsafe"
          }
        }
      ]
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "schema_version": {
      "const": "export_queue_item_v1"
    },
    "status": {
      "enum": [
        "pending",
        "sending",
        "sent",
        "failed",
        "dropped"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "queue_id",
    "status",
    "redaction_profile",
    "payload_ref",
    "payload_sha256"
  ],
  "title": "export_queue_item_v1",
  "type": "object"
}
