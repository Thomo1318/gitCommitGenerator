{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_empty_string_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/replay_compare_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Replay lineage compare record (S6). Replay always writes a new bundle and never mutates the source. regression_status is a closed four-value set.",
  "properties": {
    "schema_version": {
      "const": "replay_compare_v1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "source_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "replay_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "lineage_ok": {
      "type": "boolean"
    },
    "session_thread_id": {
      "type": "string"
    },
    "source_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "replay_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source_trace_id": {
      "type": "string"
    },
    "replay_trace_id": {
      "type": "string"
    },
    "pinned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness_version",
        "metric_catalog",
        "schema_pack"
      ],
      "properties": {
        "harness_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "metric_catalog": {
          "$ref": "#/$defs/pin_ref"
        },
        "schema_pack": {
          "$ref": "#/$defs/pin_ref"
        },
        "prompt_pack": {
          "$ref": "#/$defs/pin_ref"
        },
        "model": {
          "type": "string"
        },
        "dataset_snapshot": {
          "type": "string"
        }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_equal": {
          "type": "boolean"
        },
        "first_divergent_span": {
          "type": "string"
        },
        "metric_deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean",
                "string",
                "null",
                "array",
                "object"
              ]
            }
          }
        },
        "artifact_delta": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string",
              "null",
              "array",
              "object"
            ]
          }
        },
        "product_result_delta": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string",
              "null",
              "array",
              "object"
            ]
          }
        },
        "eval_result_delta": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string",
              "null",
              "array",
              "object"
            ]
          }
        }
      }
    },
    "first_divergence": {
      "type": "string"
    },
    "regression_status": {
      "enum": [
        "improved",
        "regressed",
        "unchanged",
        "incomparable"
      ],
      "type": "string"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/iso8601"
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_id",
    "replay_id",
    "lineage_ok",
    "regression_status"
  ],
  "title": "replay_compare_v1",
  "type": "object"
}
