{
  "$defs": {
    "artifact_class": {
      "description": "Closed set; unknown must fail closed",
      "enum": [
        "final_accept",
        "fixture_expected",
        "fixture",
        "live_regen",
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "plan_only",
        "trajectory_only",
        "train_row",
        "export_batch"
      ],
      "type": "string"
    },
    "authority": {
      "enum": [
        "law",
        "advisory",
        "lab",
        "ops",
        "projection"
      ],
      "type": "string"
    },
    "family": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "Cprime",
        "human",
        "lab",
        "dogfood",
        "gate",
        "binding",
        "export",
        "nlp"
      ],
      "type": "string"
    },
    "feedback_target": {
      "enum": [
        "trace",
        "span",
        "thread",
        "artifact"
      ],
      "type": "string"
    },
    "input_artifact": {
      "enum": [
        "final_message",
        "plan",
        "bundle",
        "trajectory",
        "fixture_envelope",
        "judge_input"
      ],
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "pin_ref": {
      "pattern": "^[a-z0-9_]+_v[0-9]+@[a-f0-9]{64}$",
      "type": "string"
    },
    "polarity": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "pass_fail"
      ],
      "type": "string"
    },
    "provenance_label": {
      "enum": [
        "Git-raw",
        "Git-mid",
        "Gold-final",
        "Rewrite-map-confirmed",
        "Opik-unbound",
        "final_accept",
        "live_regen",
        "fixture"
      ],
      "type": "string"
    },
    "redaction_profile": {
      "description": "R14 owner redaction ladder",
      "enum": [
        "public_ci",
        "default_scrub",
        "private_message",
        "train_rich",
        "antipattern_vault",
        "message_only",
        "meta_eval_scrub",
        "raw_dev_unsafe"
      ],
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "warn",
        "info"
      ],
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "enum": [
        "local_wrapper",
        "lane_c_judge",
        "human",
        "lab_meta",
        "export_health"
      ],
      "type": "string"
    },
    "iso8601": {
      "description": "ISO-8601 timestamp string (UTC preferred)",
      "minLength": 1,
      "type": "string"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "https://git-cg.local/schemas/eval/commit_session_thread_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Full commit-unit thread (R13). Additive; does not delete traces. S3 writer owns required fields; S6 may attach optional R13 links (repo_fingerprints, stages, preference_pairs, train_label, opik_thread_ref). Lifecycle/timestamps remain under established meta layout.",
  "properties": {
    "attempt_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "message_versions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "meta": {
      "type": "object"
    },
    "metric_catalog": {
      "$ref": "#/$defs/pin_ref"
    },
    "notes": {
      "type": "string"
    },
    "schema_pack": {
      "$ref": "#/$defs/pin_ref"
    },
    "schema_version": {
      "const": "commit_session_thread_v1"
    },
    "session_thread_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "redaction_profile": {
      "$ref": "#/$defs/redaction_profile"
    },
    "repo_fingerprints": {
      "type": "object",
      "description": "Optional non-secret repo fingerprints (S6 additive).",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "stages": {
      "type": "array",
      "description": "Optional ordered stage timeline (S6 additive).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "t": {
            "$ref": "#/$defs/iso8601"
          },
          "status": {
            "type": "string"
          },
          "refs": {
            "$ref": "#/$defs/string_list"
          }
        }
      }
    },
    "preference_pairs": {
      "type": "array",
      "description": "Optional preference pairs (S6 additive).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chosen_version_id": {
            "type": "string"
          },
          "rejected_version_ids": {
            "$ref": "#/$defs/string_list"
          },
          "owner_approved": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "train_label": {
      "enum": [
        "positive_gold",
        "hard_negative",
        "preference_chosen",
        "preference_rejected",
        "unlabeled",
        "holdout",
        "positive"
      ],
      "type": "string",
      "description": "Optional train-axis label (observational; not gate)."
    },
    "opik_thread_ref": {
      "type": "string",
      "description": "Optional Opik thread reference (mirror only; never sole SoT)."
    }
  },
  "required": [
    "schema_version",
    "id",
    "session_thread_id",
    "redaction_profile"
  ],
  "title": "commit_session_thread_v1",
  "type": "object"
}
