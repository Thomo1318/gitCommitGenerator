name "generate_ai_commit"
bin "generate_ai_commit"
about "Generate AI commit messages based on staged changes"

flag "-e --engine" {
    help "AI engine to use"
    arg "<ENGINE>"
    default "gemini"
}

flag "-d --dry-run" {
    help "Do not write the commit message, just print it"
}

flag "-v --verbose" {
    help "Enable verbose output"
}

arg "<COMMIT_MSG_FILE>" {
    help "Path to the commit message file"
    required #true
}

arg "<COMMIT_SOURCE>" {
    help "Source of the commit message (e.g., 'message', 'template', 'merge', 'squash', 'commit')"
    required #false
}
