amends "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.51.0/hk@1.51.0#/Builtins.pkl"

// Minimum hk binary version. Keep intentionally aligned with the Pkl package amend
// and the exact `hk` pin in mise.toml.
min_hk_version = "1.45.0"

local linters = new Mapping<String, Step> {
    ["ruff"] = Builtins.ruff
    ["ruff-format"] {
        glob = "**/*.py"
        check = "ruff format --check {{ files }}"
        fix = "ruff format {{ files }}"
    }
    ["betterleaks"] {
        check = "betterleaks git -v --staged"
    }
    ["gen-docs"] {
        glob = "usage.kdl"
        check = "just docs-hook"
        fix = "just docs-hook"
    }
    ["gen-toc"] {
        glob = "README.md"
        check = "npx doctoc {{ files }} --notitle"
        fix = "npx doctoc {{ files }} --notitle"
    }

    // Slow-only coverage verification. Default pre-commit stays fast.
    // Enable with: hk check --slow   or   HK_PROFILE=slow
    ["pytest-cov"] {
        profiles = List("slow")
        // Align with CI / pyproject: scope to package, branch coverage, XML for Codecov.
        check = "uv run pytest --cov=src/git_cg --cov-branch --cov-report=xml --cov-report=term-missing:skip-covered"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["prepare-commit-msg"] {
        steps = new Mapping<String, Step> {
            ["git-cg"] {
                check = "uv run python -m git_cg.main commit \"{{commit_msg_file}}\" \"{{source}}\""
                fix = "uv run python -m git_cg.main commit \"{{commit_msg_file}}\" \"{{source}}\""
            }
        }
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["validate-commit"] {
                check = "node scripts/validateCommitHook.mjs \"{{commit_msg_file}}\""
                fix = "node scripts/validateCommitHook.mjs \"{{commit_msg_file}}\""
            }
            ["git-cg-telemetry"] {
                check = "uv run python -m git_cg.main record-telemetry \"{{commit_msg_file}}\""
                fix = "uv run python -m git_cg.main record-telemetry \"{{commit_msg_file}}\""
            }
        }
    }
}
