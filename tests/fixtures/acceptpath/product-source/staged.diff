 """Simple greeter used by accept-path product-source dogfood."""
 
-def greet(name: str) -> str:
-    return f"hello, {name}"
+def greet(name: str, *, excited: bool = False) -> str:
+    base = f"hello, {name}"
+    return f"{base}!" if excited else base
+
+
+def greet_many(names: list[str]) -> list[str]:
+    return [greet(n) for n in names]
