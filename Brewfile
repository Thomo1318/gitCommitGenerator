# Local Brewfile for AI Models / Inference Engines
# Run `brew bundle` in this directory to install these tools.

# MTPLX - Native MTP speculative decoding on Apple Silicon
tap "youssofal/mtplx"
brew "youssofal/mtplx/mtplx"

# oMLX - LLM inference server optimized for Apple Silicon
tap "jundot/omlx"
brew "jundot/omlx/omlx"
