{
  "$schema": "./gitops_sop.schema.json",
  "_meta": {
    "purpose": "Comprehensive GitOps SOP and reference matrix for AI Agents generating Hybrid Gitmoji/Conventional Commits, calculating SemVer bumps, generating Changelogs, and handling Releases.",
    "version": "1.0.0",
    "enforcement": "MANDATORY: Agents MUST ingest these rules and use the embedded matrices for all version control operations to prevent malformed history and corrupted file syntaxes."
  },
  "specifications_and_standards": {
    "commit_format": {
      "standard": "Hybrid (Gitmoji + Conventional Commits)",
      "syntax": "<emoji> <cc_type>(<scope>): <subject>",
      "example": "✨ feat(auth): implement OAuth2 login",
      "rules": [
        "The <subject> MUST be imperative, present tense (e.g., 'change' not 'changed' or 'changes').",
        "The <subject> MUST NOT end with a period.",
        "The total length of the subject line MUST NOT exceed 72 characters.",
        "If the diff includes breaking changes, append '!' after the scope: `<emoji> <cc_type>(<scope>)!: <subject>`."
      ]
    },
    "semver_specification": {
      "regex": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-zA-Z0-9-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "faq_rules": "v0.x.x is for initial development; the public API should not be considered stable. v1.0.0 defines the public API."
    },
    "version_injection_matrix": {
      "enforcement": "When tasked with versioning a standalone file, the agent MUST use the syntax mapped to the file extension. NEVER inject comments into unsupported formats like JSON. Default to project-level files (e.g., package.json, VERSION) unless executing on a standalone script.",
      "strategies": {
        "json": {
          "extensions": [".json"],
          "method": "root_key",
          "syntax": "\"version\": \"{SEMVER}\"",
          "rule": "DO NOT use comments. Find or create a `version` key at the root object level."
        },
        "hash_comment": {
          "extensions": [".py", ".sh", ".yaml", ".yml", ".rb", ".conf"],
          "method": "header_comment",
          "syntax": "# version: v{SEMVER}",
          "rule": "Inject or replace on line 1 or 2 of the file."
        },
        "slash_comment": {
          "extensions": [".js", ".ts", ".c", ".cpp", ".java", ".go"],
          "method": "header_comment",
          "syntax": "// version: v{SEMVER}",
          "rule": "Inject or replace on line 1 or 2 of the file."
        },
        "block_comment": {
          "extensions": [".html", ".xml", ".md"],
          "method": "header_comment",
          "syntax": "<!-- version: v{SEMVER} -->",
          "rule": "Inject or replace at the top of the document."
        }
      }
    }
  },
  "agentic_commit_workflow": {
    "philosophy": "Traceable, machine-readable, and visually clear history. Never hallucinate intent.",
    "phases": [
      "Phase 1: Diff Analysis. Execute `git diff` to identify the exact files changed and the nature of the logic altered.",
      "Phase 2: Intent Classification. Determine the PRIMARY intent of the commit. Does it add a feature, fix a bug, or merely refactor?",
      "Phase 3: Matrix Query. Query the `gitmoji_reference_matrix` and select the single most appropriate object based on the `description`.",
      "Phase 4: Subject Line Generation. Format strictly according to `specifications_and_standards.commit_format.syntax`.",
      "Phase 5: Body Generation. If the diff is complex, leave a blank line after the subject and write a detailed body explaining 'Why' and 'What'.",
      "Phase 6: Commit Execution. Execute the commit."
    ]
  },
  "agentic_release_workflow": {
    "philosophy": "Automated, deterministic releases based entirely on semantic commit history.",
    "phases": [
      "Phase 1: Log Parsing. Read the git commit history since the last SemVer tag.",
      "Phase 2: SemVer Calculation. Evaluate the `semver_impact` of all commits in the parsed log. The highest impact (MAJOR > MINOR > PATCH) dictates the bump. Exception: If current version is 0.x.x, breaking changes may only trigger a MINOR bump depending on project rules.",
      "Phase 3: Target Resolution. Identify the file to receive the version bump (e.g., `package.json`, `VERSION`, or a standalone script).",
      "Phase 4: File Injection. Use the `version_injection_matrix` and the `semver_regex` to safely find and update the version string in the target file without corrupting syntax.",
      "Phase 5: Changelog Generation. Follow `changelog_generation_rules` to parse the recent commits, group them by taxonomy, and prepend to CHANGELOG.md.",
      "Phase 6: Tag & Release. Commit the version and changelog updates using 🔖 (`:bookmark:`). Create an annotated git tag (`git tag -a v<VERSION> -m 'Release v<VERSION>'`). Suggest or execute the forge CLI command (e.g., `gh release create`) to push the tag and release notes."
    ]
  },
  "changelog_generation_rules": {
    "enforcement": "Do not dump a raw git log. Parse the hybrid commits and group them under markdown headers based on the `changelog_group` mapped in the reference matrix.",
    "taxonomy": [
      "Added: for new features (e.g., ✨ feat).",
      "Changed: for changes in existing functionality (e.g., ♻️ refactor, 🎨 style).",
      "Deprecated: for soon-to-be removed features (e.g., 🗑️).",
      "Removed: for now removed features (e.g., 🔥).",
      "Fixed: for any bug fixes (e.g., 🐛 fix).",
      "Security: in case of vulnerabilities (e.g., 🔒️).",
      "Miscellaneous: for chores, docs, and build updates (e.g., 📝 docs, 🚀 chore)."
    ]
  },
  "semver_resolution_matrix": {
    "MAJOR": "Triggered ONLY by commits containing 'BREAKING CHANGE' in the body, or an exclamation mark in the hybrid format (e.g., `feat(api)!:` or 💥 `:boom:`).",
    "MINOR": "Triggered by any `cc_type` mapped to 'feat' (e.g., ✨ `:sparkles:`).",
    "PATCH": "Triggered by `cc_type` mapped to 'fix', 'perf', or 'refactor' (e.g., 🐛 `:bug:`, ⚡️ `:zap:`).",
    "NONE": "Triggered by `cc_type` mapped to 'docs', 'chore', 'test', 'ci'. Does not trigger a version bump on its own."
  },
